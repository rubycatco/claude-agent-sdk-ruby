module ClaudeAgentSDK
  # Every hook event name the CLI can send (keys of ClaudeAgentOptions#hooks).
  HOOK_EVENTS: Array[String]

  # The typed input a hook callback receives (UnknownHookInput for an event
  # this SDK version does not model).
  type hook_input = PreToolUseHookInput
                  | PostToolUseHookInput
                  | UserPromptSubmitHookInput
                  | StopHookInput
                  | SubagentStopHookInput
                  | PostToolUseFailureHookInput
                  | NotificationHookInput
                  | SubagentStartHookInput
                  | PermissionRequestHookInput
                  | PreCompactHookInput
                  | SessionStartHookInput
                  | SessionEndHookInput
                  | SetupHookInput
                  | TeammateIdleHookInput
                  | TaskCompletedHookInput
                  | ConfigChangeHookInput
                  | WorktreeCreateHookInput
                  | WorktreeRemoveHookInput
                  | StopFailureHookInput
                  | PostCompactHookInput
                  | PermissionDeniedHookInput
                  | TaskCreatedHookInput
                  | ElicitationHookInput
                  | ElicitationResultHookInput
                  | InstructionsLoadedHookInput
                  | CwdChangedHookInput
                  | FileChangedHookInput
                  | PostToolBatchHookInput
                  | UserPromptExpansionHookInput
                  | PreModelSwitchHookInput
                  | PostModelSwitchHookInput
                  | DirectoryAddedHookInput
                  | MessageDisplayHookInput
                  | UnknownHookInput

  # A *HookSpecificOutput (SyncHookJSONOutput#hook_specific_output).
  type hook_specific_output = SetupHookSpecificOutput
                            | PreToolUseHookSpecificOutput
                            | PostToolUseHookSpecificOutput
                            | PostToolUseFailureHookSpecificOutput
                            | UserPromptSubmitHookSpecificOutput
                            | NotificationHookSpecificOutput
                            | SubagentStartHookSpecificOutput
                            | PermissionRequestHookSpecificOutput
                            | SessionStartHookSpecificOutput
                            | PermissionDeniedHookSpecificOutput
                            | CwdChangedHookSpecificOutput
                            | FileChangedHookSpecificOutput
                            | PostToolBatchHookSpecificOutput
                            | UserPromptExpansionHookSpecificOutput
                            | StopHookSpecificOutput
                            | SubagentStopHookSpecificOutput
                            | PreModelSwitchHookSpecificOutput
                            | PostModelSwitchHookSpecificOutput
                            | ElicitationHookSpecificOutput
                            | ElicitationResultHookSpecificOutput
                            | WorktreeCreateHookSpecificOutput
                            | MessageDisplayHookSpecificOutput

  # What a hook callback returns: a Hash (Symbol or String keys, snake_case
  # or camelCase, also inside hook_specific_output), a typed output, or nil
  # (treated as {}).
  type hook_output = Hash[Symbol | String, untyped] | SyncHookJSONOutput | AsyncHookJSONOutput | nil

  # A hook callback (HookMatcher#hooks entries). tool_use_id is nil for
  # events without a tool call.
  interface _HookCallback
    def call: (hook_input input, String? tool_use_id, HookContext context) -> hook_output
  end

  # Routes one hook event to callbacks (ClaudeAgentOptions#hooks values).
  class HookMatcher < Type
    def initialize: (?matcher: String?, ?hooks: Array[_HookCallback]?, ?timeout: Numeric?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # Tool-name pattern (e.g. "Bash", "Write|Edit"); nil matches everything.
    attr_accessor matcher: String?

    # Never nil after construction ([] by default).
    attr_accessor hooks: Array[_HookCallback]?

    # Seconds.
    attr_accessor timeout: Numeric?
  end

  # The context passed to a hook callback.
  class HookContext < Type
    attr_accessor signal: CancellationSignal?

    attr_accessor request_id: String?
  end

  # Fields every hook input carries. Hook inputs are parsed from CLI output
  # and stay lenient: a field the CLI did not send reads nil.
  class BaseHookInput < Type
    attr_accessor session_id: String?

    attr_accessor transcript_path: String?

    attr_accessor cwd: String?

    attr_accessor permission_mode: String?

    # UUID of the user prompt being processed (the prompt.id of the CLI's
    # OpenTelemetry events); nil before the first prompt.
    attr_accessor prompt_id: String?

    # Reasoning effort in effect for the turn, e.g. { level: "high" }; sent
    # on models that support effort.
    attr_accessor effort: wire_hash?

    # The payload exactly as the CLI sent it (Symbol keys), including fields
    # this SDK does not model.
    attr_accessor raw_input: Hash[Symbol | String, untyped]?

    # The event name, fixed by the subclass (read-only).
    attr_reader hook_event_name: String?
  end

  class PreToolUseHookInput < BaseHookInput
    attr_accessor tool_name: String?

    attr_accessor tool_input: wire_hash?

    attr_accessor tool_use_id: String?

    attr_accessor agent_id: String?

    attr_accessor agent_type: String?
  end

  class PostToolUseHookInput < BaseHookInput
    attr_accessor tool_name: String?

    attr_accessor tool_input: wire_hash?

    attr_accessor tool_response: untyped

    attr_accessor tool_use_id: String?

    attr_accessor agent_id: String?

    attr_accessor agent_type: String?

    # Tool execution time, without permission prompts and hooks.
    attr_accessor duration_ms: Integer?
  end

  class UserPromptSubmitHookInput < BaseHookInput
    attr_accessor prompt: String?

    attr_accessor session_title: String?

    attr_accessor source: String?
  end

  class StopHookInput < BaseHookInput
    attr_accessor stop_hook_active: bool?

    attr_accessor last_assistant_message: String?

    attr_accessor background_tasks: Array[wire_hash]?

    attr_accessor session_crons: Array[wire_hash]?
  end

  class SubagentStopHookInput < BaseHookInput
    attr_accessor stop_hook_active: bool?

    attr_accessor agent_id: String?

    attr_accessor agent_transcript_path: String?

    attr_accessor agent_type: String?

    attr_accessor last_assistant_message: String?

    attr_accessor background_tasks: Array[wire_hash]?

    attr_accessor session_crons: Array[wire_hash]?
  end

  class PostToolUseFailureHookInput < BaseHookInput
    attr_accessor tool_name: String?

    attr_accessor tool_input: wire_hash?

    attr_accessor tool_use_id: String?

    attr_accessor error: String?

    attr_accessor is_interrupt: bool?

    attr_accessor agent_id: String?

    attr_accessor agent_type: String?

    # Tool execution time, without permission prompts and hooks.
    attr_accessor duration_ms: Integer?
  end

  class NotificationHookInput < BaseHookInput
    attr_accessor message: String?

    attr_accessor title: String?

    attr_accessor notification_type: String?
  end

  class SubagentStartHookInput < BaseHookInput
    attr_accessor agent_id: String?

    attr_accessor agent_type: String?
  end

  class PermissionRequestHookInput < BaseHookInput
    attr_accessor tool_name: String?

    attr_accessor tool_input: wire_hash?

    attr_accessor permission_suggestions: Array[wire_hash]?

    attr_accessor agent_id: String?

    attr_accessor agent_type: String?
  end

  class PreCompactHookInput < BaseHookInput
    attr_accessor trigger: String?

    attr_accessor custom_instructions: String?
  end

  class SessionStartHookInput < BaseHookInput
    attr_accessor source: String?

    attr_accessor agent_type: String?

    attr_accessor model: String?

    attr_accessor session_title: String?

    # resume/fork: seconds since the transcript's last assistant response.
    attr_accessor seconds_since_last_response: Numeric?

    # resume/fork: whether that exceeds the prompt-cache TTL.
    attr_accessor prompt_cache_likely_expired: bool?

    attr_accessor context_tokens: Integer?

    attr_accessor estimated_cache_write_usd: Numeric?
  end

  class SessionEndHookInput < BaseHookInput
    attr_accessor reason: String?
  end

  class SetupHookInput < BaseHookInput
    attr_accessor trigger: String?
  end

  class TeammateIdleHookInput < BaseHookInput
    attr_accessor teammate_name: String?

    attr_accessor team_name: String?
  end

  class TaskCompletedHookInput < BaseHookInput
    attr_accessor task_id: String?

    attr_accessor task_subject: String?

    attr_accessor task_description: String?

    attr_accessor teammate_name: String?

    attr_accessor team_name: String?
  end

  class ConfigChangeHookInput < BaseHookInput
    attr_accessor source: String?

    attr_accessor file_path: String?
  end

  class WorktreeCreateHookInput < BaseHookInput
    attr_accessor name: String?
  end

  class WorktreeRemoveHookInput < BaseHookInput
    attr_accessor worktree_path: String?
  end

  class StopFailureHookInput < BaseHookInput
    attr_accessor error: String?

    attr_accessor error_details: String?

    attr_accessor last_assistant_message: String?
  end

  class PostCompactHookInput < BaseHookInput
    attr_accessor trigger: String?

    attr_accessor compact_summary: String?
  end

  class PermissionDeniedHookInput < BaseHookInput
    attr_accessor tool_name: String?

    attr_accessor tool_input: wire_hash?

    attr_accessor tool_use_id: String?

    attr_accessor reason: String?

    attr_accessor agent_id: String?

    attr_accessor agent_type: String?
  end

  class TaskCreatedHookInput < BaseHookInput
    attr_accessor task_id: String?

    attr_accessor task_subject: String?

    attr_accessor task_description: String?

    attr_accessor teammate_name: String?

    attr_accessor team_name: String?
  end

  class ElicitationHookInput < BaseHookInput
    attr_accessor mcp_server_name: String?

    attr_accessor message: String?

    attr_accessor mode: String?

    attr_accessor url: String?

    attr_accessor elicitation_id: String?

    attr_accessor requested_schema: wire_hash?
  end

  class ElicitationResultHookInput < BaseHookInput
    attr_accessor mcp_server_name: String?

    attr_accessor elicitation_id: String?

    attr_accessor mode: String?

    attr_accessor action: String?

    # The elicitation result as the CLI sent it; its shape depends on the
    # mode (form: a wire_hash of field values, url: a token String).
    attr_accessor content: untyped
  end

  class InstructionsLoadedHookInput < BaseHookInput
    attr_accessor file_path: String?

    attr_accessor memory_type: String?

    attr_accessor load_reason: String?

    attr_accessor globs: Array[String]?

    attr_accessor trigger_file_path: String?

    attr_accessor parent_file_path: String?
  end

  class CwdChangedHookInput < BaseHookInput
    attr_accessor old_cwd: String?

    attr_accessor new_cwd: String?
  end

  class FileChangedHookInput < BaseHookInput
    attr_accessor file_path: String?

    attr_accessor event: String?
  end

  class PostToolBatchHookInput < BaseHookInput
    # { tool_name:, tool_input:, tool_use_id:, tool_response: } wire_hashes.
    attr_accessor tool_calls: Array[wire_hash]?
  end

  class UserPromptExpansionHookInput < BaseHookInput
    # "slash_command" or "mcp_prompt".
    attr_accessor expansion_type: String?

    attr_accessor command_name: String?

    attr_accessor command_args: String?

    attr_accessor command_source: String?

    attr_accessor prompt: String?
  end

  class PreModelSwitchHookInput < BaseHookInput
    attr_accessor from_model: String?

    attr_accessor to_model: String?

    # An alias, a full id, or nil for the default.
    attr_accessor requested_model: String?

    attr_accessor source: String?

    attr_accessor context_tokens: Integer?

    attr_accessor prompt_cache_warm: bool?

    # "5m" or "1h".
    attr_accessor cache_ttl: String?

    attr_accessor estimated_cache_write_usd: Numeric?

    # The rate the estimate used: "configured", "catalog" or "default".
    attr_accessor pricing: String?
  end

  class PostModelSwitchHookInput < BaseHookInput
    attr_accessor from_model: String?

    attr_accessor to_model: String?

    # An alias, a full id, or nil for the default.
    attr_accessor requested_model: String?

    attr_accessor source: String?

    attr_accessor context_tokens: Integer?

    attr_accessor prompt_cache_warm: bool?

    # "5m" or "1h".
    attr_accessor cache_ttl: String?

    attr_accessor estimated_cache_write_usd: Numeric?

    # The rate the estimate used: "configured", "catalog" or "default".
    attr_accessor pricing: String?
  end

  class DirectoryAddedHookInput < BaseHookInput
    attr_accessor directory: String?

    # "slash_command" or "register_repo_root".
    attr_accessor source: String?
  end

  class MessageDisplayHookInput < BaseHookInput
    attr_accessor turn_id: String?

    attr_accessor message_id: String?

    attr_accessor index: Integer?

    attr_accessor final: bool?

    attr_accessor delta: String?
  end

  class UnknownHookInput < BaseHookInput
  end

  # Hook outputs are built by the caller: keyword constructors (the Hash
  # form is accepted too), an unknown key raises ArgumentError, and
  # hook_event_name is fixed by the class. #to_h is the camelCase wire form.

  class SetupHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PreToolUseHookSpecificOutput < Type
    def initialize: (?permission_decision: String?, ?permission_decision_reason: String?, ?updated_input: Hash[Symbol | String, untyped]?, ?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor permission_decision: String?

    attr_accessor permission_decision_reason: String?

    attr_accessor updated_input: Hash[Symbol | String, untyped]?

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PostToolUseHookSpecificOutput < Type
    def initialize: (?additional_context: String?, ?updated_mcp_tool_output: untyped, ?updated_tool_output: untyped) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_accessor updated_mcp_tool_output: untyped

    attr_accessor updated_tool_output: untyped

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PostToolUseFailureHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class UserPromptSubmitHookSpecificOutput < Type
    def initialize: (?additional_context: String?, ?session_title: String?, ?suppress_original_prompt: bool?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_accessor session_title: String?

    # With decision "block": leave the prompt out of the block message.
    attr_accessor suppress_original_prompt: bool?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class NotificationHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class SubagentStartHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PermissionRequestHookSpecificOutput < Type
    def initialize: (?decision: Hash[Symbol | String, untyped]?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor decision: Hash[Symbol | String, untyped]?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class SessionStartHookSpecificOutput < Type
    def initialize: (?additional_context: String?, ?initial_user_message: String?, ?session_title: String?, ?watch_paths: Array[String]?, ?reload_skills: bool?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    # Becomes the session's first user message.
    attr_accessor initial_user_message: String?

    # Ignored when the session starts from "clear" or "compact".
    attr_accessor session_title: String?

    # Absolute paths to watch for FileChanged events.
    attr_accessor watch_paths: Array[String]?

    # Re-scan skill and command directories once SessionStart hooks finish.
    attr_accessor reload_skills: bool?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PermissionDeniedHookSpecificOutput < Type
    def initialize: (?retry: bool?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # nil (the default) sends no key, which the CLI reads as false.
    attr_accessor retry: bool?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class CwdChangedHookSpecificOutput < Type
    def initialize: (?watch_paths: Array[String]?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor watch_paths: Array[String]?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class FileChangedHookSpecificOutput < Type
    def initialize: (?watch_paths: Array[String]?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor watch_paths: Array[String]?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PostToolBatchHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class UserPromptExpansionHookSpecificOutput < Type
    def initialize: (?additional_context: String?, ?suppress_original_prompt: bool?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    # With decision "block": leave the prompt out of the block message.
    attr_accessor suppress_original_prompt: bool?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # additional_context is feedback for the model; the conversation continues.
  class StopHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # additional_context is feedback for the subagent; it continues.
  class SubagentStopHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PreModelSwitchHookSpecificOutput < Type
    def initialize: (?permission_decision: String?, ?permission_decision_reason: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # "allow" proceeds, "deny" cancels; "ask" refuses outside an interactive session.
    attr_accessor permission_decision: String?

    attr_accessor permission_decision_reason: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class PostModelSwitchHookSpecificOutput < Type
    def initialize: (?additional_context: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # Reaches the model with the next request the new model serves.
    attr_accessor additional_context: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # Answers an MCP elicitation request.
  class ElicitationHookSpecificOutput < Type
    def initialize: (?action: String?, ?content: Hash[Symbol | String, untyped]?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # "accept", "decline" or "cancel".
    attr_accessor action: String?

    # Form values to submit with "accept".
    attr_accessor content: Hash[Symbol | String, untyped]?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # Overrides the action or content before the response reaches the MCP server.
  class ElicitationResultHookSpecificOutput < Type
    def initialize: (?action: String?, ?content: Hash[Symbol | String, untyped]?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # "accept", "decline" or "cancel".
    attr_accessor action: String?

    attr_accessor content: Hash[Symbol | String, untyped]?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  class WorktreeCreateHookSpecificOutput < Type
    def initialize: (?worktree_path: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # Absolute path of the created worktree.
    attr_accessor worktree_path: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # Display only: the stored message and what the model sees are unchanged.
  class MessageDisplayHookSpecificOutput < Type
    def initialize: (?display_content: String?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    # Shown in place of the text; nil shows the original.
    attr_accessor display_content: String?

    attr_reader hook_event_name: String

    def to_h: () -> Hash[Symbol, untyped]
  end

  # Defers the hook's decision (async: true by default).
  class AsyncHookJSONOutput < Type
    def initialize: (?async: bool?, ?async_timeout: Integer?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor async: bool?

    # Milliseconds.
    attr_accessor async_timeout: Integer?

    def to_h: () -> Hash[Symbol, untyped]
  end

  # A synchronous hook result (continue: true, suppress_output: false by
  # default).
  class SyncHookJSONOutput < Type
    def initialize: (?continue: bool?, ?suppress_output: bool?, ?stop_reason: String?, ?decision: String?, ?system_message: String?, ?reason: String?, ?hook_specific_output: (hook_specific_output | Hash[Symbol | String, untyped])?) -> void
                  | (Hash[Symbol | String, untyped]? attributes) -> void

    attr_accessor continue: bool?

    attr_accessor suppress_output: bool?

    attr_accessor stop_reason: String?

    # "block" (or nil).
    attr_accessor decision: String?

    attr_accessor system_message: String?

    attr_accessor reason: String?

    # A typed output, or the equivalent Hash (snake_case or camelCase keys).
    # #to_h returns a Hash as written; the SDK puts its keys in wire spelling
    # when it sends the output.
    attr_accessor hook_specific_output: (hook_specific_output | Hash[Symbol | String, untyped])?

    def to_h: () -> Hash[Symbol, untyped]
  end
end
